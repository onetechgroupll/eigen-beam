    "adm-zip": "^0.5.18",
    "nanoid": "^5.1.16",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "cookie": "^0.7.2"
