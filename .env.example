# eigen.beam — Environment (alle optional; sinnvolle Defaults für lokal)

# Deck-Persistenz-Backend: file (Default) | memory | postgres
#   file     → JSON-Dateien unter EB_DATA_DIR (überlebt lokale Restarts)
#   memory   → flüchtig (Tests/CI/Wegwerf)
#   postgres → Railway/Postgres via DATABASE_URL; vorher `bun run db:migrate`
# EB_DECK_STORE=file

# Verzeichnis für den File-Deck-Store (Default: .data/decks)
# EB_DATA_DIR=.data/decks

# Bild-Asset-Store: local (Default) | s3
# EB_ASSET_STORE=local

# Lokaler sicherer Bild-Asset-Store (Default: .data/assets).
# EB_ASSET_DIR=.data/assets

# Adapter-node Origin für CSRF-Prüfung bei form/multipart POSTs (Railway: öffentliche URL setzen).
# ORIGIN=http://localhost:3000

# Secret für GET /api/rooms/:id/stats via Authorization: Bearer ... oder x-eigenbeam-stats-secret.
# Nicht als Query-String senden; Presenter-Cookie ist auf /present/:id scoped.
# EB_STATS_SECRET=

# Clarity-Engine: ohne Key läuft ein deterministischer lokaler Fallback.
# ANTHROPIC_API_KEY=
# EB_CLAUDE_MODEL=claude-3-5-sonnet-latest

# Magic-Link Auth: ohne Secret nutzt lokale Dev-Outbox einen unsicheren Fallback.
# EB_MAGIC_LINK_SECRET=
# Dev-only: gibt den Magic-Link zusätzlich im JSON zurück. In Prod leer/false lassen.
# EB_AUTH_RETURN_LINK=false

# Remote MCP endpoint (/mcp) für AI-Clients. Immer als Authorization: Bearer *** senden.
# Einzeltoken/Legacy:
# EB_MCP_TOKEN=
# Rotation/mehrere Clients: kommagetrennt oder mehrzeilig; EB_MCP_TOKEN bleibt zusätzlich gültig.
# EB_MCP_TOKENS=

# Replay/Follow-Persistenz: ohne DATABASE_URL bleibt Live/Replays lokal; mit DATABASE_URL
# spiegelt EB_ACTIVITY_STORE=postgres Replay-Sessions, Events und Follows in Postgres.
# EB_ACTIVITY_STORE=postgres
# EB_FOLLOWS_FILE=.data/follows.json

# Email-Provider für Magic-Link + Follow-Confirmation:
#   outbox  → Default, schreibt JSON-Mails nach EB_DATA_DIR/outbox
#   console → loggt nur
#   resend/postmark → echter Versand mit API-Key + verifizierter Sender-Domain
# EB_MAIL_PROVIDER=outbox
# EB_MAIL_FROM=eigen.beam <no-reply@eigen.beam.local>
# EB_RESEND_API_KEY=
# EB_POSTMARK_TOKEN=

# Railway-Postgres (für PostgresDeckRepository + Migration)
# DATABASE_URL=postgres://user:***@host:5432/db

# Railway Bucket / S3 (für EB_ASSET_STORE=s3)
# EB_BUCKET_ENDPOINT=
# EB_BUCKET_NAME=
# EB_BUCKET_REGION=auto
# EB_BUCKET_PUBLIC_URL=
# EB_BUCKET_ACCESS_KEY=
# EB_BUCKET_SECRET_KEY=
