# eigen.beam environment. Everything is optional for local development.
# Production mode (NODE_ENV=production) fails closed: it requires Postgres,
# EB_MAGIC_LINK_SECRET and the other values marked [prod]. See docs/deployment.md.

# Public origin, used for CSRF checks on form/multipart POSTs and absolute links. [prod]
# ORIGIN=http://localhost:3000

# --- Decks ---------------------------------------------------------------
# Deck store: file (default) | memory | postgres
#   file     -> JSON files under EB_DATA_DIR, survives local restarts
#   memory   -> volatile (tests, CI, throwaway)
#   postgres -> DATABASE_URL; run `bun run db:migrate` first          [prod]
# EB_DECK_STORE=file
# EB_DATA_DIR=.data/decks

# --- Assets --------------------------------------------------------------
# Image store: local (default) | s3                                     [prod: s3]
# EB_ASSET_STORE=local
# EB_ASSET_DIR=.data/assets
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Railway Buckets, ...)
# EB_BUCKET_ENDPOINT=
# EB_BUCKET_NAME=
# EB_BUCKET_REGION=auto
# EB_BUCKET_PUBLIC_URL=
# EB_BUCKET_ACCESS_KEY=
# EB_BUCKET_SECRET_KEY=

# --- Database ------------------------------------------------------------
# DATABASE_URL=postgres://user:***@host:5432/db

# Replay sessions, events and follows: off (default) | postgres         [prod]
# EB_ACTIVITY_STORE=postgres
# EB_FOLLOWS_FILE=.data/follows.json

# --- Auth ----------------------------------------------------------------
# Signs magic-link sessions and PIN cookies. Without it, local dev uses an
# insecure fallback.                                                    [prod]
# EB_MAGIC_LINK_SECRET=
# Dev only: also return the magic link in the JSON response. Keep false in prod.
# EB_AUTH_RETURN_LINK=false

# Secret for GET /api/rooms/:id/stats, sent as `Authorization: Bearer ...` or
# `x-eigenbeam-stats-secret`. Never as a query string.
# EB_STATS_SECRET=

# --- Mail ----------------------------------------------------------------
# Provider for magic links and follow confirmations:
#   outbox (default) -> JSON files under EB_DATA_DIR/outbox
#   console          -> log only
#   resend | postmark -> real delivery, needs an API key and a verified domain [prod]
# EB_MAIL_PROVIDER=outbox
# EB_MAIL_FROM=eigen.beam <no-reply@eigen.beam.local>
# EB_RESEND_API_KEY=
# EB_POSTMARK_TOKEN=

# --- AI (optional) -------------------------------------------------------
# Clarity engine and import re-layout. Without a key a deterministic local
# fallback runs.
# ANTHROPIC_API_KEY=
# EB_CLAUDE_MODEL=claude-3-5-sonnet-latest
# Voice-to-slides transcription needs one of these.
# OPENAI_API_KEY=

# --- MCP (remote endpoint /mcp for AI clients) ---------------------------
# Bearer tokens. Without any token /mcp fails closed with 401.          [prod]
# EB_MCP_TOKEN=
# Several clients / rotation: comma- or newline-separated; EB_MCP_TOKEN stays valid.
# EB_MCP_TOKENS=
# Optional OAuth client_credentials issuer (both required to issue tokens).
# EB_OAUTH_TOKEN_SECRET=
# EB_OAUTH_CLIENTS=client-id:client-secret|deck:read+room:create
